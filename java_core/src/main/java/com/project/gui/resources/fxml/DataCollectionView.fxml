<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<SplitPane orientation="HORIZONTAL" dividerPositions="0.28"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.project.gui.controller.DataCollectionController">
    <!-- LEFT: Scrollable Controls Sidebar -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="results-scroll">
        <VBox styleClass="panel" spacing="14">
            <padding><Insets top="20" right="18" bottom="20" left="18"/></padding>

            <Label text="Cài đặt cào dữ liệu trực tiếp" styleClass="section-title"/>
            <Separator/>

            <Label text="Từ khóa" styleClass="field-label"/>
            <TextField fx:id="keywordField" promptText="Ví dụ: bão, lũ lụt, sạt lở..."
                       styleClass="text-field-styled"/>

            <Label text="Khoảng thời gian" styleClass="field-label"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <DatePicker fx:id="startDatePicker" promptText="Từ ngày" HBox.hgrow="ALWAYS"/>
                <Label text="→"/>
                <DatePicker fx:id="endDatePicker"   promptText="Đến ngày"   HBox.hgrow="ALWAYS"/>
            </HBox>

            <Label text="Nguồn thu thập" styleClass="field-label"/>
            <HBox spacing="16">
                <CheckBox fx:id="facebookCheck" text="Facebook"  selected="true"/>
                <CheckBox fx:id="twitterCheck"  text="Twitter"   selected="false"/>
            </HBox>

            <Label text="Các trang/Liên kết Facebook mục tiêu" styleClass="field-label"/>
            <ListView fx:id="pagesListView" prefHeight="110" styleClass="text-field-styled"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <TextField fx:id="newPageField" promptText="Nhập tên trang hoặc link..." HBox.hgrow="ALWAYS" styleClass="text-field-styled"/>
                <Button text="＋ Thêm" onAction="#onAddPage" styleClass="btn-secondary" style="-fx-padding: 6 10 6 10;"/>
                <Button text="🗑 Xóa" onAction="#onRemovePage" styleClass="btn-secondary" style="-fx-padding: 6 10 6 10; -fx-background-color: #7f8c8d;"/>
            </HBox>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="fetchButton" text="🔍  Thu thập bài viết" onAction="#onFetchPosts"
                        styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="cancelButton" text="✕ Hủy" onAction="#onCancelScraping"
                        styleClass="btn-secondary" style="-fx-background-color: #c0392b; -fx-padding: 9 18 9 18;" visible="false" managed="false"/>
            </HBox>

            <HBox fx:id="loadingBox" spacing="10" alignment="CENTER_LEFT" visible="false" managed="false">
                <ProgressIndicator prefWidth="20" prefHeight="20"/>
                <Label text="Đang cào bài viết Facebook trực tiếp..." style="-fx-text-fill: -color-primary; -fx-font-weight: bold;"/>
            </HBox>

            <Separator/>

            <!-- Historical event dataset selection -->
            <Label text="Dữ liệu chiến dịch lịch sử" styleClass="section-title"/>
            <Separator/>

            <Label text="Chiến dịch" styleClass="field-label"/>
            <ComboBox fx:id="campaignComboBox" promptText="Chọn chiến dịch..." maxWidth="Infinity"/>

            <!-- Notice that onLoadHistoricalCampaign was moved to AnalysisController in the original request, but it's part of DataCollection UI -->
            <!-- The user's prompt says: "DataCollection: onFetchPosts(), onAddPage(), onRemovePage(), onCancelScraping(), setupPostsTable()" -->
            <!-- And "AnalysisController: onRunAnalysis(), renderDetailedReport(), renderHistoricalCharts()" (Wait, I thought onLoadHistoricalCampaign was in analysis). Let's check the user prompt: "Tab 1 (Data Collection): onFetchPosts(), onAddPage(), onRemovePage(), onCancelScraping(), setupPostsTable()". "Tab 2 (Analysis): onRunAnalysis(), renderDetailedReport(), renderHistoricalCharts()". -->
            <!-- Since campaignComboBox is in Tab 1, onLoadHistoricalCampaign MUST be in DataCollectionController. -->
            <Button text="📂 Tải dữ liệu chiến dịch" onAction="#onLoadHistoricalCampaign"
                    styleClass="btn-secondary" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label fx:id="statusLabel" text="Sẵn sàng." styleClass="status-label"
                   wrapText="true"/>
        </VBox>
    </ScrollPane>

    <!-- RIGHT: Posts Table -->
    <VBox styleClass="panel" spacing="10">
        <padding><Insets top="20" right="18" bottom="20" left="18"/></padding>
        <Label text="Các bài viết đã thu thập" styleClass="section-title"/>
        <Separator/>
        <TableView fx:id="postsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colPostId"    text="Mã bài đăng"        prefWidth="90"/>
                <TableColumn fx:id="colContent"   text="Nội dung"   prefWidth="280"/>
                <TableColumn fx:id="colReactions" text="Phản ứng nổi bật" prefWidth="180"/>
                <TableColumn fx:id="colComments"  text="Bình luận nổi bật"  prefWidth="220"/>
                <TableColumn fx:id="colTimestamp" text="Thời gian" prefWidth="120"/>
            </columns>
            <placeholder><Label text="Chưa có bài đăng nào được thu thập."/></placeholder>
        </TableView>
    </VBox>
</SplitPane>
