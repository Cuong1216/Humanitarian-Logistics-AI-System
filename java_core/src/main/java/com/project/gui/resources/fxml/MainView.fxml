<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.chart.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.project.gui.controller.AppController"
            stylesheets="@../css/style.css">

    <!-- ── HEADER ── -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Label text="🆘" style="-fx-font-size:24px;"/>
            <VBox spacing="2">
                <Label text="Hệ thống Điều phối Cứu trợ Thiên tai" styleClass="header-title"/>
                <Label text="Phân tích Mạng xã hội &amp; Logistics thời gian thực" styleClass="header-subtitle"/>
            </VBox>
        </HBox>
    </top>

    <!-- ── MAIN CONTENT: TabPane ── -->
    <center>
        <TabPane styleClass="main-tab-pane" tabClosingPolicy="UNAVAILABLE">

            <!-- ══════════════════════════════════════════
                 TAB 1: DATA COLLECTION
            ══════════════════════════════════════════ -->
            <Tab text="📡  Thu thập dữ liệu">
                <fx:include source="DataCollectionView.fxml" fx:id="dataCollection"/>
            </Tab>

            <!-- ══════════════════════════════════════════
                 TAB 2: ANALYSIS
            ══════════════════════════════════════════ -->
            <Tab text="🧠  Phân tích">
                <fx:include source="AnalysisView.fxml" fx:id="analysis"/>
            </Tab>

            <!-- ══════════════════════════════════════════
                 TAB 3: LOGISTICS
            ══════════════════════════════════════════ -->
            <Tab text="🚛  Điều phối hỗ trợ">
                <fx:include source="LogisticsView.fxml" fx:id="logistics"/>
            </Tab>

        </TabPane>
    </center>

    <!-- ── FOOTER ── -->
    <bottom>
        <HBox styleClass="footer" alignment="CENTER_RIGHT" spacing="12">
            <padding><Insets top="8" right="20" bottom="8" left="20"/></padding>
            <Label text="Hệ thống Điều phối Cứu trợ Thiên tai v1.0  •  Hỗ trợ bởi Trí tuệ Nhân tạo"
                   styleClass="footer-label"/>
        </HBox>
    </bottom>

</BorderPane>
