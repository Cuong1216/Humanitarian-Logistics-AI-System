<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.chart.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.project.gui.controller.AppController"
            stylesheets="@../css/style.css">

    <!-- ── HEADER ── -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Label text="🆘" style="-fx-font-size:24px;"/>
            <VBox spacing="2">
                <Label text="Hệ thống Điều phối Cứu trợ Thiên tai" styleClass="header-title"/>
                <Label text="Phân tích Mạng xã hội &amp; Logistics thời gian thực" styleClass="header-subtitle"/>
            </VBox>
        </HBox>
    </top>

    <!-- ── MAIN CONTENT: TabPane ── -->
    <center>
        <TabPane styleClass="main-tab-pane" tabClosingPolicy="UNAVAILABLE">

            <!-- ══════════════════════════════════════════
                 TAB 1: DATA COLLECTION
            ══════════════════════════════════════════ -->
            <Tab text="📡  Thu thập dữ liệu">
                <SplitPane orientation="HORIZONTAL" dividerPositions="0.35">

                    <!-- LEFT: Scrollable Controls Sidebar -->
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="results-scroll">
                        <VBox styleClass="panel" spacing="14">
                            <padding><Insets top="20" right="18" bottom="20" left="18"/></padding>

                            <Label text="Cài đặt cào dữ liệu trực tiếp" styleClass="section-title"/>
                            <Separator/>

                            <Label text="Từ khóa" styleClass="field-label"/>
                            <TextField fx:id="keywordField" promptText="Ví dụ: bão, lũ lụt, sạt lở..."
                                       styleClass="text-field-styled"/>

                            <Label text="Khoảng thời gian" styleClass="field-label"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <DatePicker fx:id="startDatePicker" promptText="Từ ngày" HBox.hgrow="ALWAYS"/>
                                <Label text="→"/>
                                <DatePicker fx:id="endDatePicker"   promptText="Đến ngày"   HBox.hgrow="ALWAYS"/>
                            </HBox>

                            <Label text="Nguồn thu thập" styleClass="field-label"/>
                            <HBox spacing="16">
                                <CheckBox fx:id="facebookCheck" text="Facebook"  selected="true"/>
                                <CheckBox fx:id="twitterCheck"  text="Twitter"   selected="false"/>
                            </HBox>

                            <Label text="Các trang/Liên kết Facebook mục tiêu" styleClass="field-label"/>
                            <ListView fx:id="pagesListView" prefHeight="110" styleClass="text-field-styled"/>
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <TextField fx:id="newPageField" promptText="Nhập tên trang hoặc link..." HBox.hgrow="ALWAYS" styleClass="text-field-styled"/>
                                <Button text="＋ Thêm" onAction="#onAddPage" styleClass="btn-secondary" style="-fx-padding: 6 10 6 10;"/>
                                <Button text="🗑 Xóa" onAction="#onRemovePage" styleClass="btn-secondary" style="-fx-padding: 6 10 6 10; -fx-background-color: #7f8c8d;"/>
                            </HBox>

                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Button fx:id="fetchButton" text="🔍  Thu thập bài viết" onAction="#onFetchPosts"
                                        styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button fx:id="cancelButton" text="✕ Hủy" onAction="#onCancelScraping"
                                        styleClass="btn-secondary" style="-fx-background-color: #c0392b; -fx-padding: 9 18 9 18;" visible="false" managed="false"/>
                            </HBox>


                            <HBox fx:id="loadingBox" spacing="10" alignment="CENTER_LEFT" visible="false" managed="false">
                                <ProgressIndicator prefWidth="20" prefHeight="20"/>
                                <Label text="Đang cào bài viết Facebook trực tiếp..." style="-fx-text-fill: -color-primary; -fx-font-weight: bold;"/>
                            </HBox>

                            <Separator/>

                            <!-- Historical event dataset selection -->
                            <Label text="Dữ liệu chiến dịch lịch sử" styleClass="section-title"/>
                            <Separator/>

                            <Label text="Chiến dịch" styleClass="field-label"/>
                            <ComboBox fx:id="campaignComboBox" promptText="Chọn chiến dịch..." maxWidth="Infinity"/>

                            <Button text="📂 Tải dữ liệu chiến dịch" onAction="#onLoadHistoricalCampaign"
                                    styleClass="btn-secondary" maxWidth="Infinity"/>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Label fx:id="statusLabel" text="Sẵn sàng." styleClass="status-label"
                                   wrapText="true"/>
                        </VBox>
                    </ScrollPane>

                    <!-- RIGHT: Posts Table -->
                    <VBox styleClass="panel" spacing="10">
                        <padding><Insets top="20" right="18" bottom="20" left="18"/></padding>
                        <Label text="Các bài viết đã thu thập" styleClass="section-title"/>
                        <Separator/>
                        <TableView fx:id="postsTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colPostId"    text="Mã bài đăng"        prefWidth="90"/>
                                <TableColumn fx:id="colContent"   text="Nội dung"   prefWidth="280"/>
                                <TableColumn fx:id="colReactions" text="Phản ứng nổi bật" prefWidth="180"/>
                                <TableColumn fx:id="colComments"  text="Bình luận nổi bật"  prefWidth="220"/>
                                <TableColumn fx:id="colTimestamp" text="Thời gian" prefWidth="120"/>
                            </columns>
                            <placeholder><Label text="Chưa có bài đăng nào được thu thập."/></placeholder>
                        </TableView>
                    </VBox>

                </SplitPane>
            </Tab>

            <!-- ══════════════════════════════════════════
                 TAB 2: ANALYSIS
            ══════════════════════════════════════════ -->
            <Tab text="🧠  Phân tích">
                <SplitPane orientation="HORIZONTAL" dividerPositions="0.28">

                    <!-- LEFT: Analyzer selection -->
                    <VBox styleClass="panel" spacing="14">
                        <padding><Insets top="20" right="18" bottom="20" left="18"/></padding>

                        <Label text="Chọn bộ phân tích" styleClass="section-title"/>
                        <Separator/>

                        <VBox spacing="10">
                            <CheckBox fx:id="sentimentCheck" text="Cảm xúc theo thời gian"
                                      selected="true"   styleClass="analyzer-check"/>
                            <Label text="Theo dõi và vẽ biểu đồ cảm xúc của dư luận theo thời gian."
                                   styleClass="hint-label" wrapText="true"/>

                            <CheckBox fx:id="damageCheck" text="Phân loại danh mục thiệt hại"
                                      selected="true"   styleClass="analyzer-check"/>
                            <Label text="Phân loại các bài đăng theo các loại thiệt hại chính như con người, nhà cửa, hạ tầng, nông nghiệp..."
                                   styleClass="hint-label" wrapText="true"/>

                            <CheckBox fx:id="reliefCheck" text="Nhu cầu cứu trợ"
                                      selected="false"  styleClass="analyzer-check"/>
                            <Label text="Xác định các loại nhu yếu phẩm cần hỗ trợ dựa trên bài đăng."
                                   styleClass="hint-label" wrapText="true"/>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <Button fx:id="runAnalysisButton" text="▶  Chạy phân tích" onAction="#onRunAnalysis"
                                styleClass="btn-primary" maxWidth="Infinity"/>
                    </VBox>

                    <!-- RIGHT: Tabbed Analysis Output -->
                    <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="sub-tab-pane">
                        <tabs>
                            <!-- Mode A: Live Dispatch Panel -->
                            <Tab text="⚡ Hỗ trợ điều phối thời gian thực">
                                <ScrollPane fitToWidth="true" styleClass="results-scroll">
                                    <VBox fx:id="resultsBox" styleClass="results-box" spacing="12">
                                        <padding><Insets top="20" right="18" bottom="20" left="18"/></padding>
                                        <Label text="Đề xuất về mức độ khẩn cấp và nhu yếu phẩm theo thời gian thực sẽ hiển thị ở đây."
                                               styleClass="hint-label"/>
                                    </VBox>
                                </ScrollPane>
                            </Tab>
                            
                            <!-- Mode B: Historical Trend Analytics -->
                            <Tab text="📈 Phân tích xu hướng lịch sử">
                                <ScrollPane fitToWidth="true" styleClass="results-scroll">
                                    <VBox spacing="20" style="-fx-padding: 20;">
                                        <!-- Negativity Line Chart -->
                                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 16; -fx-border-color: #d8dce4; -fx-border-radius: 6; -fx-background-radius: 6;">
                                            <Label text="📈 Xu hướng chỉ số tiêu cực (Theo thời gian)" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -color-text;"/>
                                            <LineChart fx:id="negativityLineChart" prefHeight="280" animated="false">
                                                <xAxis>
                                                    <CategoryAxis label="Thời gian"/>
                                                </xAxis>
                                                <yAxis>
                                                    <NumberAxis label="Chỉ số tiêu cực" lowerBound="0.0" upperBound="1.0" tickUnit="0.1" autoRanging="false"/>
                                                </yAxis>
                                            </LineChart>
                                        </VBox>
                                        
                                        <!-- Emotion Stacked Bar Chart -->
                                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 16; -fx-border-color: #d8dce4; -fx-border-radius: 6; -fx-background-radius: 6;">
                                            <Label text="📊 Phân tích trạng thái cảm xúc chủ đạo" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -color-text;"/>
                                            <StackedBarChart fx:id="emotionStackedChart" prefHeight="280" animated="false">
                                                <xAxis>
                                                    <CategoryAxis label="Thời gian"/>
                                                </xAxis>
                                                <yAxis>
                                                    <NumberAxis label="Số lượng bài viết"/>
                                                </yAxis>
                                            </StackedBarChart>
                                        </VBox>
                                        
                                        <!-- Severity and Needed Items Breakdown HBox -->
                                        <HBox spacing="20" alignment="CENTER">
                                            <!-- Severity Pie Chart -->
                                            <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 16; -fx-border-color: #d8dce4; -fx-border-radius: 6; -fx-background-radius: 6;">
                                                <Label text="📊 Phân bố tỷ lệ các loại thiệt hại" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -color-text;"/>
                                                <PieChart fx:id="severityPieChart" prefHeight="280" animated="false"/>
                                            </VBox>
                                            
                                            <!-- Need Categories Bar Chart -->
                                            <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 16; -fx-border-color: #d8dce4; -fx-border-radius: 6; -fx-background-radius: 6;">
                                                <Label text="📊 Tần suất số lượng báo cáo thiệt hại" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -color-text;"/>
                                                <BarChart fx:id="damageTypeBarChart" prefHeight="280" animated="false">
                                                    <xAxis>
                                                        <CategoryAxis label="Danh mục thiệt hại"/>
                                                    </xAxis>
                                                    <yAxis>
                                                        <NumberAxis label="Số lượng báo cáo"/>
                                                    </yAxis>
                                                </BarChart>
                                            </VBox>
                                        </HBox>
                                        
                                        <!-- Milestones Summary -->
                                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 16; -fx-border-color: #d8dce4; -fx-border-radius: 6; -fx-background-radius: 6;">
                                            <Label text="📅 Các cột mốc thời gian quan trọng" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -color-text;"/>
                                            <VBox fx:id="timelineMilestonesBox" spacing="8">
                                                <Label text="Dòng thời gian sự kiện sẽ hiển thị sau khi chạy phân tích." styleClass="hint-label"/>
                                            </VBox>
                                        </VBox>
                                        
                                        <!-- Damage Analysis Detailed Explanations -->
                                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 16; -fx-border-color: #d8dce4; -fx-border-radius: 6; -fx-background-radius: 6;">
                                            <Label text="📝 Diễn giải mức độ ảnh hưởng theo từng danh mục thiệt hại" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -color-text;"/>
                                            <VBox fx:id="damageExplanationsBox" spacing="8">
                                                <Label text="Báo cáo diễn giải chi tiết sẽ hiển thị sau khi tải dữ liệu chiến dịch hoặc chạy phân tích." styleClass="hint-label"/>
                                            </VBox>
                                        </VBox>

                                        <!-- Post-by-post Severity & Damage Type table -->
                                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 16; -fx-border-color: #d8dce4; -fx-border-radius: 6; -fx-background-radius: 6;">
                                            <Label text="📋 Chi tiết phân loại danh mục thiệt hại theo từng bài viết" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -color-text;"/>
                                            <TableView fx:id="historicalPostsTable" prefHeight="260" VBox.vgrow="ALWAYS">
                                                <columns>
                                                    <TableColumn fx:id="colHistPostId" text="Mã bài viết" prefWidth="90"/>
                                                    <TableColumn fx:id="colHistPlatform" text="Nền tảng" prefWidth="85"/>
                                                    <TableColumn fx:id="colHistContent" text="Nội dung bài đăng" prefWidth="320"/>
                                                    <TableColumn fx:id="colHistSeverity" text="Danh mục thiệt hại chính" prefWidth="180"/>
                                                    <TableColumn fx:id="colHistDamageType" text="Từ khóa bằng chứng (Evidence)" prefWidth="180"/>
                                                </columns>
                                                <placeholder><Label text="Vui lòng tải dữ liệu chiến dịch hoặc chạy phân tích."/></placeholder>
                                            </TableView>
                                        </VBox>
                                    </VBox>
                                </ScrollPane>
                            </Tab>
                        </tabs>
                    </TabPane>

                </SplitPane>
            </Tab>

            <!-- ══════════════════════════════════════════
                 TAB 3: LOGISTICS
            ══════════════════════════════════════════ -->
            <Tab text="🚛  Điều phối hỗ trợ">
                <SplitPane orientation="HORIZONTAL" dividerPositions="0.45">
                    <!-- Left Control Panel -->
                    <ScrollPane fitToWidth="true" styleClass="results-scroll">
                        <VBox styleClass="panel" spacing="14">
                            <padding><Insets top="20" right="18" bottom="20" left="18"/></padding>

                            <Label text="Hệ thống điều phối cứu trợ" styleClass="section-title"/>
                            <Label text="Kết nối vị trí khẩn cấp (phát hiện bởi AI) với trung tâm cứu trợ &amp; phương tiện gần nhất" styleClass="hint-label" wrapText="true"/>
                            <Separator/>

                            <!-- Section 1: Distress Locations Table -->
                            <Label text="🚨 Các điểm khẩn cấp cần hỗ trợ" styleClass="field-label"/>
                            <TableView fx:id="distressTable" prefHeight="180" VBox.vgrow="NEVER">
                                <columns>
                                    <TableColumn fx:id="colDistressLocation" text="Vị trí"     prefWidth="130"/>
                                    <TableColumn fx:id="colDistressUrgency"  text="Độ khẩn cấp"      prefWidth="90"/>
                                    <TableColumn fx:id="colDistressSupplies" text="Nhu yếu phẩm" prefWidth="150"/>
                                    <TableColumn fx:id="colDistressStatus"   text="Trạng thái"        prefWidth="100"/>
                                </columns>
                                <placeholder><Label text="Chưa có điểm khẩn cấp. Vui lòng chạy phân tích AI trước."/></placeholder>
                            </TableView>

                            <!-- Section 2: Support Centers -->
                            <Label text="🏥 Các trung tâm cứu trợ &amp; Nguồn lực hiện có" styleClass="field-label"/>
                            <TableView fx:id="supportCenterTable" prefHeight="140" VBox.vgrow="NEVER">
                                <columns>
                                    <TableColumn fx:id="colCenterName"      text="Tên trung tâm" prefWidth="160"/>
                                    <TableColumn fx:id="colCenterResources" text="Nguồn lực sẵn có" prefWidth="180"/>
                                    <TableColumn fx:id="colCenterVehicles"  text="Phương tiện"    prefWidth="80"/>
                                </columns>
                            </TableView>

                            <!-- Section 3: Dispatch Routing -->
                            <Label text="📍 Thiết lập lộ trình điều phối" styleClass="field-label"/>
                            <Separator/>

                            <GridPane hgap="10" vgap="8">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="125" prefWidth="125" />
                                    <ColumnConstraints hgrow="ALWAYS" />
                                </columnConstraints>
                                
                                <Label text="Trung tâm phù hợp:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <Label fx:id="matchedCenterLabel" text="Chưa chọn" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: -color-secondary; -fx-font-weight: bold;"/>

                                <Label text="Phương tiện phù hợp:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <Label fx:id="matchedVehicleLabel" text="Chưa chọn" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-text-fill: -color-secondary; -fx-font-weight: bold;"/>

                                <Label text="Điểm xuất phát:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="startLocField" promptText="Vị trí trung tâm cung ứng" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="text-field-styled"/>

                                <Label text="Điểm đến:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="destLocField" promptText="Vị trí cần cứu trợ" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="text-field-styled"/>
                            </GridPane>

                            <HBox spacing="8">
                                <Button fx:id="dispatchButton" text="🚀 Bắt đầu vận chuyển" onAction="#onDispatchResources" styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button text="📍 Vẽ lộ trình" onAction="#onFindRoute" styleClass="btn-secondary" style="-fx-background-color: #2980b9;"/>
                                <Button text="🧹 Xóa bản đồ" onAction="#onResetMap" styleClass="btn-secondary" style="-fx-background-color: #7f8c8d;"/>
                            </HBox>

                            <Label text="Thông tin lộ trình &amp; Nhật ký điều phối" styleClass="field-label"/>
                            <TextArea fx:id="routeOutput" editable="false" prefRowCount="6" styleClass="route-output" promptText="Chọn một điểm khẩn cấp hoặc nhập vị trí để xem thông tin lộ trình..."/>
                        </VBox>
                    </ScrollPane>

                    <!-- Right Map Panel -->
                    <VBox styleClass="panel">
                        <WebView fx:id="mapWebView" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </SplitPane>
            </Tab>

        </TabPane>
    </center>

    <!-- ── FOOTER ── -->
    <bottom>
        <HBox styleClass="footer" alignment="CENTER_RIGHT" spacing="12">
            <padding><Insets top="8" right="20" bottom="8" left="20"/></padding>
            <Label text="Hệ thống Điều phối Cứu trợ Thiên tai v1.0  •  Hỗ trợ bởi Trí tuệ Nhân tạo"
                   styleClass="footer-label"/>
        </HBox>
    </bottom>

</BorderPane>
